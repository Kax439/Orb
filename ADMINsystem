-- RATE LIMITING & COOLDOWNS
local function checkRateLimit(player)
    local now = tick()
    if not rateLimit[player.Name] then
        rateLimit[player.Name] = {count = 1, time = now}
        return true
    end

    if now - rateLimit[player.Name].time > 10 then
        rateLimit[player.Name] = {count = 1, time = now}
        return true
    end

    rateLimit[player.Name].count = rateLimit[player.Name].count + 1
    return rateLimit[player.Name].count <= 5
end

local function canUseCommand(plr, cmd)
    local key = plr.UserId .. "_" .. cmd
    if commandCooldowns[key] and tick() - commandCooldowns[key] < 1 then
        return false
    end
    commandCooldowns[key] = tick()
    return true
end

-- PLAYER TARGETING SYSTEM
local function getPlayers(plr, str)
    if not str then return {} end
    str = str:lower()
    local targets = {}
    
    local specialTargets = {
        all = function() return game.Players:GetPlayers() end,
        others = function()
            local others = {}
            for _, p in pairs(game.Players:GetPlayers()) do
                if p ~= plr then table.insert(others, p) end
            end
            return others
        end,
        me = function() return {plr} end,
        admins = function()
            local admins = {}
            for _, p in pairs(game.Players:GetPlayers()) do
                if isAdmin(p.Name) then table.insert(admins, p) end
            end
            return admins
        end,
        nonadmins = function()
            local nonadmins = {}
            for _, p in pairs(game.Players:GetPlayers()) do
                if not isAdmin(p.Name) then table.insert(nonadmins, p) end
            end
            return nonadmins
        end,
        random = function()
            local allPlayers = game.Players:GetPlayers()
            if #allPlayers > 0 then
                return {allPlayers[math.random(1, #allPlayers)]}
            end
            return {}
        end
    }
    
    if specialTargets[str] then
        return specialTargets[str]()
    else
        for _, p in pairs(game.Players:GetPlayers()) do
            if p.Name:lower():find(str) then
                table.insert(targets, p)
            end
        end
    end
    return targets
end

