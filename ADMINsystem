-- Building & World Editing
commands["city"] = function(plr, args)
    local size = tonumber(args[1]) or 5
    local startPos = plr.Character.HumanoidRootPart.Position
    
    for x = 1, size do
        for z = 1, size do
            -- Create building
            local height = math.random(5, 20)
            local building = Instance.new("Part")
            building.Size = Vector3.new(8, height, 8)
            building.Position = startPos + Vector3.new(x * 15, height/2, z * 15)
            building.Anchored = true
            building.BrickColor = BrickColor.Random()
            building.Material = Enum.Material.Concrete
            building.Parent = workspace
            
            -- Add windows
            for y = 1, height-1 do
                if y % 2 == 0 then
                    local window = Instance.new("Part")
                    window.Size = Vector3.new(6, 1, 1)
                    window.Position = building.Position + Vector3.new(0, y - height/2, 4.5)
                    window.Anchored = true
                    window.BrickColor = BrickColor.new("Bright blue")
                    window.Transparency = 0.3
                    window.Parent = workspace
                end
            end
        end
    end
    
    showNotification(plr, "City", "Generated city with "..(size*size).." buildings", "success", 5)
end

commands["obstaclecourse"] = function(plr, args)
    local length = tonumber(args[1]) or 20
    local startPos = plr.Character.HumanoidRootPart.Position
    
    for i = 1, length do
        -- Platform
        local platform = Instance.new("Part")
        platform.Size = Vector3.new(10, 1, 5)
        platform.Position = startPos + Vector3.new(i * 12, 0, 0)
        platform.Anchored = true
        platform.BrickColor = BrickColor.new("Bright green")
        platform.Parent = workspace
        
        -- Obstacles
        if i % 3 == 0 then
            local obstacle = Instance.new("Part")
            obstacle.Size = Vector3.new(2, 5, 2)
            obstacle.Position = platform.Position + Vector3.new(0, 3, 0)
            obstacle.Anchored = true
            obstacle.BrickColor = BrickColor.new("Bright red")
            obstacle.Parent = workspace
        end
        
        -- Gaps
        if i % 5 == 0 then
            platform.Transparency = 1
            platform.CanCollide = false
        end
    end
    
    -- Finish line
    local finish = Instance.new("Part")
    finish.Size = Vector3.new(10, 5, 5)
    finish.Position = startPos + Vector3.new((length+1) * 12, 2.5, 0)
    finish.Anchored = true
    finish.BrickColor = BrickColor.new("Bright yellow")
    finish.Material = Enum.Material.Neon
    finish.Parent = workspace
    
    showNotification(plr, "Obstacle Course", "Created obstacle course with "..length.." sections", "success", 5)
end

