local function logCommand(plr, command, args)
    table.insert(commandLogs, {
        player = plr.Name,
        command = command,
        args = args,
        time = os.date("%Y-%m-%d %H:%M:%S")
    })
    if #commandLogs > 100 then
        table.remove(commandLogs, 1)
    end
end

