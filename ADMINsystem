    showNotification(plr, "Auto-Clean", serverSettings.AutoClean and "Enabled" or "Disabled", "success", 3)
    
    if serverSettings.AutoClean then
        while serverSettings.AutoClean do
            wait(30)
            local count = 0
            for _, obj in pairs(workspace:GetChildren()) do
                if obj:IsA("Part") and obj.Anchored == false and obj.Position.Y < -100 then
                    obj:Destroy()
                    count = count + 1
                end
            end
            if count > 0 then
                showNotification(plr, "Auto-Clean", "Cleaned "..count.." fallen objects", "info", 2)
            end
        end
    end
end

