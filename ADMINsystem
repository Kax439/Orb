-- COMMAND HANDLER
local function onPlayerChatted(plr)
    plr.Chatted:Connect(function(msg)
        -- Security checks
        if #msg > maxCommandLength then return end
        if not checkRateLimit(plr) then 
            showNotification(plr, "Rate Limit", "Too many commands! Wait a moment.", "error", 3)
            return 
        end
        if isMuted(plr.Name) and msg:sub(1, #prefix) == prefix then
            showNotification(plr, "Muted", "You are muted and cannot use commands.", "error", 3)
            return
        end

        if msg:sub(1, #prefix) == prefix then
            local split = msg:sub(#prefix+1):split(" ")
            local cmd = split[1]:lower()
            table.remove(split, 1)

            if commands[cmd] then
                if isAdmin(plr.Name) or isOwner(plr.Name) then
                    if not canUseCommand(plr, cmd) then
                        showNotification(plr, "Cooldown", "Please wait before using this command again.", "warning", 2)
                        return
                    end
                    
                    -- Log command
                    logCommand(plr, cmd, split)
                    
                    -- Execute command
                    local success, err = pcall(function()
                        commands[cmd](plr, split)
                    end)
                    
                    if not success then
                        showNotification(plr, "Command Error", err, "error", 5)
                    end
                else
                    showNotification(plr, "Permissions", "Insufficient permissions for this command.", "error", 3)
                end
            else
                showNotification(plr, "Unknown Command", "Command not found: "..cmd, "error", 3)
            end
        end
    end)
end

-- PLAYER JOIN HANDLER
local function setupPlayer(plr)
    if not plr then return end

    -- Safe wrapper for function calls
    local function safeCall(fn, ...)
        if type(fn) == "function" then
            local success, result = pcall(fn, ...)
            if success then
                return result
            end
        end
        return nil
    end

    -- Check if banned
    local banned = safeCall(isBanned, plr.Name)
    if banned then
        plr:Kick("You are banned from this server.")
        return
    end

    -- Assign VIP / group admin if applicable
    local groupAdmin = safeCall(isGroupAdmin, plr)
    local admin = safeCall(isAdmin, plr.Name)
    if groupAdmin and not admin then
        table.insert(admins, plr.Name)
        admin = true
    end

    -- Check VIP badge
    if vipAdminBadgeId and vipAdminBadgeId > 0 then
        local success, hasBadge = pcall(function()
            return game:GetService("BadgeService"):UserHasBadge(plr.UserId, vipAdminBadgeId)
        end)
        if success and hasBadge then
            table.insert(tempAdmins, plr.Name)
            admin = true
        end
    end

    -- Welcome message
    if admin then
        safeCall(showNotification, plr, "Admin System V5", "Welcome back, "..plr.Name.."!\nType !panel for command list", "success", 8)
    else
        safeCall(showNotification, plr, "Welcome", "Welcome to the server!\nAdmins: Type !help for info", "info", 5)
    end

    -- Connect chat listener
    safeCall(onPlayerChatted, plr)
end

