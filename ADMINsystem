            local reason = table.concat(args, " ", 3) or "Temporarily banned by "..plr.Name
            table.insert(bannedPlayers, target.Name)
            showNotification(plr, "Temp Ban", "Banned "..target.Name.." for "..minutes.." minutes", "warning", 3)
            target:Kick(reason)
            
            -- Auto unban after time
            if minutes then
                delay(minutes * 60, function()
                    for i, name in pairs(bannedPlayers) do
                        if name:lower() == target.Name:lower() then
                            table.remove(bannedPlayers, i)
                            break
                        end
                    end
                end)
            end
        end
    end
end

commands["warn"] = function(plr, args)
    if #args < 1 then return end
    for _, target in pairs(getPlayers(plr, args[1])) do
        if not warnings[target.Name] then warnings[target.Name] = 0 end
        warnings[target.Name] = warnings[target.Name] + 1
