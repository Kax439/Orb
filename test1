commands["warn"] = function(plr, args)
	if #args < 1 then 
		hint("Usage: !warn [player] [reason]", {plr})
		return 
	end
	for _, target in pairs(getPlayers(plr, args[1])) do
		if not warnings[target.Name] then warnings[target.Name] = 0 end
		warnings[target.Name] = warnings[target.Name] + 1
		local reason = table.concat(args, " ", 2) or "No reason provided"
		message("WARNING", "You have been warned ("..warnings[target.Name].."/3)\nReason: "..reason, {target})

		if warnings[target.Name] >= 3 then
			target:Kick("Kicked for receiving 3 warnings")
			warnings[target.Name] = 0
		end
	end
end

commands["warnings"] = function(plr, args)
