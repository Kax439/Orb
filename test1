	-- Function to populate commands
	local function populateCommands(searchText)
		-- Clear existing content
		for _, child in pairs(scrollFrame:GetChildren()) do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end

		local yPosition = 0
		local contentHeight = 0

		for _, category in pairs(commandCategories) do
			-- Check if category matches search
			local categoryMatches = not searchText or searchText == "" or 
				category.name:lower():find(searchText:lower(), 1, true)

			local commandMatches = false
			local matchingCommands = {}

			-- Filter commands based on search
			for _, cmd in pairs(category.commands) do
				if not searchText or searchText == "" or 
					cmd:lower():find(searchText:lower(), 1, true) then
					table.insert(matchingCommands, cmd)
					commandMatches = true
				end
			end

			-- Only show category if it matches search or has matching commands
			if categoryMatches or commandMatches then
				-- Category header
				local categoryFrame = Instance.new("Frame")
				categoryFrame.Size = UDim2.new(1, 0, 0, 30)
				categoryFrame.Position = UDim2.new(0, 0, 0, yPosition)
				categoryFrame.BackgroundColor3 = Color3.new(0.25, 0.25, 0.5)
				categoryFrame.BorderSizePixel = 0
				categoryFrame.Parent = scrollFrame

				local categoryLabel = Instance.new("TextLabel")
				categoryLabel.Size = UDim2.new(1, -10, 1, 0)
				categoryLabel.Position = UDim2.new(0, 5, 0, 0)
				categoryLabel.Text = category.name
				categoryLabel.TextColor3 = Color3.new(1, 1, 1)
				categoryLabel.BackgroundTransparency = 1
				categoryLabel.TextXAlignment = Enum.TextXAlignment.Left
				categoryLabel.TextScaled = true
				categoryLabel.Font = Enum.Font.GothamBold
				categoryLabel.Parent = categoryFrame

				yPosition = yPosition + 35
				contentHeight = contentHeight + 35

				-- Commands in this category
				for _, cmd in pairs(matchingCommands) do
					local commandFrame = Instance.new("Frame")
