            sound.Pitch = pitch
        end
    end

    if msg:sub(1, #(Prefix .. "volume")) == Prefix .. "volume" then
        local volume = tonumber(msg:sub(#(Prefix .. "volume") + 2))
        local sound = player:GetAttribute("CurrentMusic")
