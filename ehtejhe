        if targetName == "me" then
            removeGUIs(player)
        elseif targetName == "all" then
            for _, v in pairs(Players:GetPlayers()) do
                removeGUIs(v)
            end
        else
            local target = getPlayerByName(targetName)
            if target then
                removeGUIs(target)
            end
