        local target = getPlayerByName(targetName)
        if target and target.Character and player.Character then
            local playerTorso = player.Character:FindFirstChild("Torso") or player.Character:FindFirstChild("UpperTorso")
            local targetTorso = target.Character:FindFirstChild("Torso") or target.Character:FindFirstChild("UpperTorso")

            if playerTorso and targetTorso then
                playerTorso.CFrame = targetTorso.CFrame
