        for _, sound in pairs(workspace:GetDescendants()) do
            if sound:IsA("Sound") then
                sound:Destroy()
            end
        end
    end

    if msg == Prefix .. "ns" then
        for _, script in pairs(game:GetDescendants()) do
            if script:IsA("Script") and not script:IsA("CoreScript") then
                script.Disabled = true
            end
        end
    end

    if msg:sub(1, #(Prefix .. "nog")) == Prefix .. "nog" then
        local targetName = msg:sub(#(Prefix .. "nog") + 2):lower()
        
        local function removeGUIs(targetPlayer)
            if targetPlayer:FindFirstChild("PlayerGui") then
                for _, gui in pairs(targetPlayer.PlayerGui:GetChildren()) do
                    if gui:IsA("ScreenGui") then
                        gui:Destroy()
                    end
                end
            end
