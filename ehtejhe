        if songParam == "watcha" then
            soundId = "rbxassetid://177681012"
        elseif songParam == "lean" then
            soundId = "rbxassetid://328474897"
        elseif songParam == "baby" then
            soundId = "rbxassetid://130841252"
        elseif songParam == "moonman" then
            soundId = "rbxassetid://340924386"
        elseif songParam == "hello" then
            soundId = "rbxassetid://313694441"
