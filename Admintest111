			if v then
				local at = 0
				local age = v.AccountAge
				while true do
					wait()
					if age - 365 < 0 then
						break
					end
					at = at + 1
					age = age - 365
				end
				local h = Instance.new("Hint", workspace)
				h.Text = v.Name.."'s Account is "..at.." Year(s) old and "..age.." Day(s) old"
				wait(4)
